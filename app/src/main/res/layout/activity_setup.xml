<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a1628">

    <!-- ========================================== -->
    <!-- TOP BAR WITH APP TITLE -->
    <!-- ========================================== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:background="#0c4a6e"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="JeepQ Track"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing=".2"/>

        <TextView
            android:id="@+id/tvAppSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Jeepney Queue Management"
            android:textColor="#94a3b8"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>

    </LinearLayout>

    <!-- ========================================== -->
    <!-- SCROLLABLE CONTENT -->
    <!-- ========================================== -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Setup Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device Setup"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configure your device role"
                android:textColor="#94a3b8"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>

            <View
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:background="#0ea5e9"
                android:layout_marginTop="12dp"
                android:alpha="0.6"/>

            <!-- ========================================== -->
            <!-- ROLE SELECTION -->
            <!-- ========================================== -->
            <TextView
                android:id="@+id/tvRoleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device Role"
                android:textColor="#e2e8f0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp"/>

            <RadioGroup
                android:id="@+id/rgRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <RadioButton
                    android:id="@+id/rbPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PRIMARY"
                    android:textColor="#ffffff"
                    android:buttonTint="#0ea5e9"
                    android:padding="14dp"
                    android:background="@drawable/radio_button_bg"
                    android:checked="false"
                    android:layout_marginEnd="6dp"/>

                <RadioButton
                    android:id="@+id/rbSecondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SECONDARY"
                    android:textColor="#ffffff"
                    android:buttonTint="#0ea5e9"
                    android:padding="14dp"
                    android:background="@drawable/radio_button_bg"
                    android:checked="true"
                    android:layout_marginStart="6dp"/>

            </RadioGroup>

            <!-- Role Description -->
            <TextView
                android:id="@+id/tvRoleDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PRIMARY: Driver/Dispatcher device | SECONDARY: Passenger counting device"
                android:textColor="#64748b"
                android:textSize="11sp"
                android:layout_marginTop="6dp"
                android:gravity="center"/>

            <!-- ========================================== -->
            <!-- DOOR SELECTION -->
            <!-- ========================================== -->
            <TextView
                android:id="@+id/tvDoorLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Door Position"
                android:textColor="#e2e8f0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"/>

            <RadioGroup
                android:id="@+id/rgDoor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <RadioButton
                    android:id="@+id/rbFront"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="FRONT"
                    android:textColor="#ffffff"
                    android:buttonTint="#0ea5e9"
                    android:padding="14dp"
                    android:background="@drawable/radio_button_bg"
                    android:checked="true"
                    android:layout_marginEnd="6dp"/>

                <RadioButton
                    android:id="@+id/rbRear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="REAR"
                    android:textColor="#ffffff"
                    android:buttonTint="#0ea5e9"
                    android:padding="14dp"
                    android:background="@drawable/radio_button_bg"
                    android:layout_marginStart="6dp"/>

            </RadioGroup>

            <!-- Door Description -->
            <TextView
                android:id="@+id/tvDoorDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FRONT: Main entrance | REAR: Back entrance"
                android:textColor="#64748b"
                android:textSize="11sp"
                android:layout_marginTop="6dp"
                android:gravity="center"/>

            <!-- ========================================== -->
            <!-- JEEP ID -->
            <!-- ========================================== -->
            <TextView
                android:id="@+id/tvJeepIdLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jeepney ID"
                android:textColor="#e2e8f0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"/>

            <!-- ========================================== -->
            <!-- SAVE BUTTON -->
            <!-- ========================================== -->
            <EditText
                android:id="@+id/etJeepId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/edittext_bg"
                android:hint="Enter Jeep ID (UUID)"
                android:inputType="text"
                android:padding="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748b"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Save Configuration"
                android:backgroundTint="#0ea5e9"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="12dp"
                android:elevation="4dp"
                android:layout_marginTop="32dp"/>

            <!-- ========================================== -->
            <!-- RESET BUTTON (Debug - Hidden by default) -->
            <!-- ========================================== -->
            <Button
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Reset Configuration"
                android:backgroundTint="#ef4444"
                android:textColor="#ffffff"
                android:textSize="13sp"
                android:padding="12dp"
                android:layout_marginTop="12dp"
                android:visibility="gone"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>