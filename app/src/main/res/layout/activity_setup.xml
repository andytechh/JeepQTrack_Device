<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clay_background">

    <!-- ========================================================= -->
    <!-- LIGHT HEADER -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp"
        android:background="@drawable/bg_setup_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SmartQs Track"
            android:textColor="@color/text_primary"
            android:textSize="25sp"
            android:textStyle="bold"
            android:letterSpacing=".04"/>

        <TextView
            android:id="@+id/tvAppSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Smart Jeepney Queue Management"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"/>



    </LinearLayout>


    <!-- ========================================================= -->
    <!-- SCROLL CONTENT -->
    <!-- ========================================================= -->

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- ================================================= -->
            <!-- PAGE TITLE -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device Configuration"
                android:textColor="@color/text_primary"
                android:textSize="23sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Configure this phone before starting passenger counting."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"/>


            <!-- ================================================= -->
            <!-- PHYSICAL DEVICE CARD -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_setup_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Physical Device"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Choose the SMS sender assigned to this phone."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"/>


                <!-- DEVICE SELECTOR -->

                <RadioGroup
                    android:id="@+id/rgDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbDevice1"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_setup_option"
                        android:checked="true"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="DEVICE 1"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbDevice2"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/bg_setup_option"
                        android:text="DEVICE 2"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                </RadioGroup>


                <!-- REGISTERED SENDER -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/bg_setup_info">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REGISTERED SMS SENDER"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing=".08"/>

                    <TextView
                        android:id="@+id/tvDeviceDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Device 1 • SMS Sender: 09938901689"
                        android:textColor="@color/ocean_primary_dark"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- DEVICE ROLE & DOOR POSITION -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_setup_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device Role &amp; Door Position"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Select the role and camera door position for this device."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"/>


                <!-- TWO COLUMN AREA -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">


                    <!-- =============================== -->
                    <!-- ROLE -->
                    <!-- =============================== -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="7dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRoleLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ROLE"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing=".08"/>

                        <RadioGroup
                            android:id="@+id/rgRole"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:orientation="vertical">

                            <RadioButton
                                android:id="@+id/rbPrimary"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:gravity="center_vertical"
                                android:paddingStart="12dp"
                                android:paddingEnd="8dp"
                                android:background="@drawable/bg_setup_option"
                                android:buttonTint="@color/ocean_primary"
                                android:checked="true"
                                android:text="PRIMARY"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"/>

                            <RadioButton
                                android:id="@+id/rbSecondary"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="7dp"
                                android:gravity="center_vertical"
                                android:paddingStart="12dp"
                                android:paddingEnd="8dp"
                                android:background="@drawable/bg_setup_option"
                                android:buttonTint="@color/ocean_primary"
                                android:text="SECONDARY"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"/>

                        </RadioGroup>

                    </LinearLayout>


                    <!-- =============================== -->
                    <!-- DOOR -->
                    <!-- =============================== -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="7dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDoorLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DOOR POSITION"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing=".08"/>

                        <RadioGroup
                            android:id="@+id/rgDoor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:orientation="vertical">

                            <RadioButton
                                android:id="@+id/rbFront"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:gravity="center_vertical"
                                android:paddingStart="12dp"
                                android:paddingEnd="8dp"
                                android:background="@drawable/bg_setup_option"
                                android:buttonTint="@color/ocean_primary"
                                android:checked="true"
                                android:text="FRONT"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"/>

                            <RadioButton
                                android:id="@+id/rbRear"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="7dp"
                                android:gravity="center_vertical"
                                android:paddingStart="12dp"
                                android:paddingEnd="8dp"
                                android:background="@drawable/bg_setup_option"
                                android:buttonTint="@color/ocean_primary"
                                android:text="REAR"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"/>

                        </RadioGroup>

                    </LinearLayout>

                </LinearLayout>


                <!-- ROLE DESCRIPTION -->

                <TextView
                    android:id="@+id/tvRoleDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="PRIMARY: Main jeepney monitoring and dispatch device"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"/>


                <!-- DOOR DESCRIPTION -->

                <TextView
                    android:id="@+id/tvDoorDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="FRONT: Main entrance / passenger boarding door"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"/>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- JEEPNEY UUID -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_setup_card">

                <TextView
                    android:id="@+id/tvJeepIdLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jeepney ID"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Enter the UUID of the jeepney assigned to this device."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"/>

                <EditText
                    android:id="@+id/etJeepId"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_setup_edittext"
                    android:hint="Enter Jeep ID (UUID)"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13sp"/>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SAVE CONFIGURATION -->
            <!-- ================================================= -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_setup_save"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Save Configuration"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"/>


            <!-- ================================================= -->
            <!-- RESET CONFIGURATION -->
            <!-- ================================================= -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_setup_reset"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:text="Reset Configuration"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"/>


            <!-- ================================================= -->
            <!-- FOOTER -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="SmartQs Track • Passenger Counting System"
                android:textColor="@color/text_muted"
                android:textSize="10sp"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>