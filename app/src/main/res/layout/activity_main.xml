<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clay_background">

    <!-- ========================================================= -->
    <!-- CAMERA BACKGROUND                                         -->
    <!-- ========================================================= -->

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/camera_placeholder"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <!-- ========================================================= -->
    <!-- YOLO OVERLAY                                               -->
    <!-- ========================================================= -->

    <com.surendramaran.Jeepqs.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- ========================================================= -->
    <!-- TOP HEADER                                                 -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="82dp"
            android:background="@drawable/bg_clay_header"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingTop="11dp"
            android:paddingEnd="12dp"
            android:paddingBottom="11dp">

            <!-- BRAND -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_clay_logo"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JQ"
                        android:textColor="@color/ocean_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JeepQTrack"
                        android:textColor="@color/text_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtJeepName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Jeepney Loading..."
                        android:textColor="@color/ocean_primary_dark"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- HEADER INFORMATION -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/roleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_clay_pill_blue"
                    android:gravity="center"
                    android:minWidth="76dp"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="PRIMARY"
                    android:textColor="@color/ocean_primary_dark"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtGpsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:text="GPS: Starting..."
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtJeepStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="3dp"
                    android:text="Inactive"
                    android:textColor="@color/ocean_primary_dark"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/doorText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="3dp"
                    android:text="Rear Door"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ========================================================= -->
    <!-- CAMERA STATUS                                             -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/cameraStatusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="105dp"
        android:background="@drawable/bg_clay_camera_status"
        android:gravity="center_vertical"
        android:paddingStart="11dp"
        android:paddingTop="6dp"
        android:paddingEnd="11dp"
        android:paddingBottom="6dp">

        <View
            android:id="@+id/cameraStatusDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_dot_green" />

        <TextView
            android:id="@+id/cameraStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="CAMERA OFF"
            android:textColor="@color/text_secondary"
            android:textSize="9sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ========================================================= -->
    <!-- BOTTOM PANEL                                               -->
    <!-- ========================================================= -->

    <ScrollView
        android:id="@+id/bottomScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/bottomContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_clay_panel"
            android:elevation="12dp"
            android:orientation="vertical"
            android:padding="13dp">

            <!-- ================================================= -->
            <!-- CAMERA CONTROLS                                    -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/cameraControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <TextView
                    android:id="@+id/btnCameraToggle"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_clay_button_green"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="▶  START CAMERA"
                    android:textColor="@color/status_green_dark"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnRotateCamera"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_clay_button_blue"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="↻  ROTATE CAMERA"
                    android:textColor="@color/ocean_primary_dark"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- CAMERA DIRECTION -->

            <TextView
                android:id="@+id/cameraFacingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:text="REAR CAMERA"
                android:textColor="@color/text_muted"
                android:textSize="7sp"
                android:textStyle="bold" />

            <!-- ================================================= -->
            <!-- OCCUPANCY SUMMARY                                  -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/occupancyHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_clay_inner"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CURRENT OCCUPANCY"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtInside"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/ocean_primary_dark"
                            android:textSize="38sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/capacityLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_marginBottom="6dp"
                            android:text="/ 24"
                            android:textColor="@color/text_muted"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/occupancyStateText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_clay_pill_green"
                        android:gravity="center"
                        android:paddingStart="9dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="6dp"
                        android:text="REAL-TIME"
                        android:textColor="@color/status_green_dark"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnToggleMore"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_clay_toggle"
                        android:gravity="center"
                        android:text="⌄"
                        android:textColor="@color/ocean_primary_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- ================================================= -->
            <!-- EXPANDED PASSENGER DETAILS                         -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/extraControlsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_clay_inner"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone">

                <!-- PROGRESS -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_clay_progress_track"
                    android:padding="1dp">

                    <View
                        android:id="@+id/occupancyProgress"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_clay_progress_fill" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Passenger capacity"
                        android:textColor="@color/text_muted"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/capacityText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24 passengers"
                        android:textColor="@color/text_secondary"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- STATISTICS -->

                <LinearLayout
                    android:id="@+id/statsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="65dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_clay_stat_blue"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BOARDED"
                            android:textColor="@color/ocean_primary_dark"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtBoarded"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/ocean_primary"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="65dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_clay_stat_orange"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EXITED"
                            android:textColor="@color/orange_dark"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtExited"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/orange_primary"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="65dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_clay_stat_green"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AVAILABLE"
                            android:textColor="@color/status_green_dark"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtAvailable"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="24"
                            android:textColor="@color/status_green"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- AI INFORMATION -->

                <LinearLayout
                    android:id="@+id/systemInfoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_clay_panel_small"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:paddingStart="10dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="7dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI"
                        android:textColor="@color/ocean_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="YOLO PASSENGER DETECTION"
                            android:textColor="@color/text_secondary"
                            android:textSize="7sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/inferenceTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 ms / frame"
                            android:textColor="@color/ocean_primary_dark"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/connectionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_clay_pill_green"
                        android:paddingStart="8dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="5dp"
                        android:text="CONNECTED"
                        android:textColor="@color/status_green_dark"
                        android:textSize="7sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- GPU -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_clay_panel_small"
                    android:gravity="center_vertical"
                    android:minHeight="42dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Inference Engine"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <ToggleButton
                        android:id="@+id/isGpu"
                        android:layout_width="68dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_clay_toggle"
                        android:button="@null"
                        android:textColor="@color/ocean_primary_dark"
                        android:textOff="CPU"
                        android:textOn="GPU"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- LOGOUT -->

                <TextView
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_clay_button_red"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="LOG OUT"
                    android:textColor="@color/red_dark"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>