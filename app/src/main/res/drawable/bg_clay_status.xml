<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:left="1dp"
        android:top="2dp"
        android:right="1dp"
        android:bottom="0dp">

        <shape android:shape="rectangle">
            <solid android:color="#B1CFD8" />
            <corners android:radius="18dp" />
        </shape>

    </item>

    <item
        android:bottom="2dp">

        <shape android:shape="rectangle">

            <solid android:color="@color/clay_surface" />

            <stroke
                android:width="1dp"
                android:color="#F8FDFF" />

            <corners android:radius="18dp" />

        </shape>

    </item>

</layer-list>