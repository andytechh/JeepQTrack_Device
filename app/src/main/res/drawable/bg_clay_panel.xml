<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:left="2dp"
        android:top="4dp"
        android:right="2dp"
        android:bottom="0dp">

        <shape android:shape="rectangle">

            <solid android:color="#A8CBD5" />

            <corners android:radius="26dp" />

        </shape>

    </item>

    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="4dp">

        <shape android:shape="rectangle">

            <solid android:color="@color/clay_surface" />

            <stroke
                android:width="1dp"
                android:color="#F8FDFF" />

            <corners android:radius="26dp" />

        </shape>

    </item>

</layer-list>