<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bottom shadow -->

    <item
        android:left="2dp"
        android:top="3dp"
        android:right="2dp"
        android:bottom="0dp">

        <shape android:shape="rectangle">

            <solid android:color="#A9CBD5" />

            <corners android:radius="24dp" />

        </shape>

    </item>

    <!-- Main surface -->

    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="3dp">

        <shape android:shape="rectangle">

            <solid android:color="@color/clay_surface" />

            <stroke
                android:width="1dp"
                android:color="#F8FDFF" />

            <corners android:radius="24dp" />

        </shape>

    </item>

</layer-list>