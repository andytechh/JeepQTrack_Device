<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:left="3dp"
        android:top="4dp">

        <shape android:shape="rectangle">

            <corners android:radius="17dp" />

            <solid android:color="#B6DCC8" />

        </shape>

    </item>

    <item
        android:right="3dp"
        android:bottom="3dp">

        <shape android:shape="rectangle">

            <corners android:radius="17dp" />

            <solid android:color="#DFF7EA" />

            <stroke
                android:width="1dp"
                android:color="#C0E9D3" />

        </shape>

    </item>

</layer-list>