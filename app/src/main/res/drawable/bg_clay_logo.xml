<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:left="2dp"
        android:top="3dp"
        android:right="0dp"
        android:bottom="0dp">

        <shape android:shape="oval">
            <solid android:color="#A8CBD5" />
        </shape>

    </item>

    <item
        android:left="0dp"
        android:top="0dp"
        android:right="2dp"
        android:bottom="3dp">

        <shape android:shape="oval">

            <solid android:color="#D3F2FD" />

            <stroke
                android:width="1dp"
                android:color="#F8FDFF" />

        </shape>

    </item>

</layer-list>