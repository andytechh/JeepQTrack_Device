<!-- res/drawable/radio_button_bg.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <solid android:color="#0a1a2e" />
            <stroke android:width="2dp" android:color="#0ea5e9" />
            <corners android:radius="8dp" />
            <padding android:left="12dp" android:right="12dp" android:top="10dp" android:bottom="10dp"/>
        </shape>
    </item>
    <item android:state_checked="false">
        <shape>
            <solid android:color="#1a1a2e" />
            <stroke android:width="1dp" android:color="#334155" />
            <corners android:radius="8dp" />
            <padding android:left="12dp" android:right="12dp" android:top="10dp" android:bottom="10dp"/>
        </shape>
    </item>
</selector>