<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:left="2dp"
        android:top="2dp">

        <shape android:shape="rectangle">

            <corners android:radius="17dp" />

            <solid android:color="#C6E5EF" />

        </shape>

    </item>

    <item
        android:right="2dp"
        android:bottom="2dp">

        <shape android:shape="rectangle">

            <corners android:radius="17dp" />

            <solid android:color="#EDF9FD" />

            <stroke
                android:width="1dp"
                android:color="#D0EBF4" />

        </shape>

    </item>

</layer-list>